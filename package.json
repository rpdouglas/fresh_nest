{
  "name": "freshnest-ecosystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm --workspace=apps/customer run dev",
    "dev:fsm": "npm --workspace=apps/fsm run dev",
    "build:customer": "npm --workspace=apps/customer run build",
    "build:fsm": "npm --workspace=apps/fsm run build",
    "build": "npm run build:customer && npm run build:fsm",
    "test:customer": "npm --workspace=apps/customer run test",
    "test:customer:rules": "npm --workspace=apps/customer run test:rules",
    "test:customer:e2e": "npm --workspace=apps/customer run test:e2e",
    "test:fsm": "npm --workspace=apps/fsm run test",
    "lint": "npm --workspaces run lint --if-present"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack-query-firebase/react": "^2.1.1",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.43.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
