rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // P3-E35: office roles. Owners and Managers have the same data access; only Owners can give or
    // take away office roles, and that happens in the setUserRole function, not here.
    // The legacy 'admin' claim is no longer accepted (P3-E35 cleanup).
    function isOffice() {
      return request.auth != null && request.auth.token.role in ['owner', 'manager'];
    }

    // Helper: staff app roles (staff, field supervisor) plus the office
    function isStaff() {
      return request.auth != null
        && request.auth.token.role in ['staff', 'supervisor', 'owner', 'manager'];
    }

    // P3-E37 (W0-3): the `lastChange` stamp on audited records names who made each save; the audit
    // triggers turn it into the audit log. A new stamp must name the signed-in person (or `public`
    // for a signed-out quote/review) and carry the request time. TOLERANT PERIOD: a save may leave
    // the stamp out or unchanged; a follow-up PR (~2 weeks after release) makes it required.
    function stampValid(lc) {
      return lc is map
        && lc.keys().hasAll(['by', 'at', 'source'])
        && lc.keys().hasOnly(['by', 'at', 'source', 'reason', 'overrideType'])
        && lc.at == request.time
        && (!('reason' in lc) || lc.reason == null || (lc.reason is string && lc.reason.size() <= 500))
        && (!('overrideType' in lc) || lc.overrideType == null || (lc.overrideType is string && lc.overrideType.size() <= 100))
        && (
          (request.auth != null
            && request.auth.token.email is string
            && lc.by == request.auth.token.email.lower()
            && (lc.source in ['staff_app', 'customer', 'public_form'] || (lc.source == 'admin' && isOffice())))
          || (request.auth == null && lc.by == 'public' && lc.source == 'public_form')
        );
    }

    function lastChangeOk() {
      return !('lastChange' in request.resource.data)
        || (resource != null && resource.data.get('lastChange', null) == request.resource.data.lastChange)
        || stampValid(request.resource.data.lastChange);
    }

    // 1. Bookings Collection
    match /bookings/{bookingId} {
      
      // Public Booking Creation
      allow create: if
        // A. Verify presence of all required fields (18 fields matching schema)
        request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'phone', 'language',
          'propertyType', 'bedrooms', 'bathrooms', 'frequency', 'pets',
          'address', 'serviceType', 'preferredDate', 'leadSource', 'status',
          'assignedTo', 'isAirbnb', 'photoConfirmation', 'createdAt'
        ])
        
        // B. Ensure types are correct
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0
        && request.resource.data.email is string && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10
        && request.resource.data.address is string && request.resource.data.address.size() >= 5
        && request.resource.data.bedrooms is int && request.resource.data.bedrooms >= 0
        && request.resource.data.bathrooms is int && request.resource.data.bathrooms >= 0
        && request.resource.data.pets is bool
        && request.resource.data.isAirbnb is bool
        && request.resource.data.photoConfirmation is bool
        
        // C. Enforce allowed values (Enums)
        && request.resource.data.language in ['en', 'fr']
        && request.resource.data.status == 'pending' // No customer can self-confirm
        && request.resource.data.leadSource in ['organic', 'google', 'referral', 'facebook', 'direct']
        && request.resource.data.frequency in ['one-time', 'weekly', 'biweekly', 'monthly']
        && request.resource.data.serviceType in ['standard', 'deep', 'moveout', 'postconstruction', 'airbnb', 'commercial']
        && request.resource.data.propertyType in ['apartment', '1-2bed', '3-4bed', '5+bed', 'commercial']
        
        // D. Validate constraints
        && request.resource.data.preferredDate is string && request.resource.data.preferredDate.size() == 10 // YYYY-MM-DD
        && request.resource.data.assignedTo == null // Cannot self-assign staff on create
        && request.resource.data.createdAt == request.time // Must use server timestamp
        
        // E. Validate conditional/optional fields
        && (!('marketingConsent' in request.resource.data) 
            || (request.resource.data.marketingConsent is bool 
                && request.resource.data.consentTimestamp is timestamp
                && request.resource.data.consentMethod == 'booking-form-v2'))
        && (!('addOns' in request.resource.data) || request.resource.data.addOns is list)
        && (!('squareFootage' in request.resource.data) || request.resource.data.squareFootage is int)
        && (!('preferredCleaner' in request.resource.data) 
            || (request.resource.data.preferredCleaner is string || request.resource.data.preferredCleaner == null))
        && (!('referredBy' in request.resource.data) 
            || (request.resource.data.referredBy is string || request.resource.data.referredBy == null))
        && (!('notes' in request.resource.data) || request.resource.data.notes is string)
        && (!('stripePaymentIntentId' in request.resource.data)
            || request.resource.data.stripePaymentIntentId is string)
        && (!('stripeChargeStatus' in request.resource.data)
            || request.resource.data.stripeChargeStatus == 'hold')
        && lastChangeOk();

      // Admin Booking Creation (phone-in / walk-in — P3-E3)
      allow create: if
        isOffice()

        // A. Required fields (adds createdBy vs. public branch)
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'phone', 'language',
          'propertyType', 'bedrooms', 'bathrooms', 'frequency', 'pets',
          'address', 'serviceType', 'preferredDate', 'leadSource', 'status',
          'assignedTo', 'isAirbnb', 'photoConfirmation', 'createdAt', 'createdBy'
        ])

        // B. Type checks (same as public branch)
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0
        && request.resource.data.email is string && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10
        && request.resource.data.address is string && request.resource.data.address.size() >= 5
        && request.resource.data.bedrooms is int && request.resource.data.bedrooms >= 0
        && request.resource.data.bathrooms is int && request.resource.data.bathrooms >= 0
        && request.resource.data.pets is bool
        && request.resource.data.isAirbnb is bool
        && request.resource.data.photoConfirmation is bool

        // C. Enums — admin can set confirmed and extended lead sources
        && request.resource.data.language in ['en', 'fr']
        && request.resource.data.status in ['pending', 'confirmed']
        && request.resource.data.leadSource in ['organic', 'google', 'referral', 'facebook', 'direct', 'phone', 'walk-in']
        && request.resource.data.frequency in ['one-time', 'weekly', 'biweekly', 'monthly']
        && request.resource.data.serviceType in ['standard', 'deep', 'moveout', 'postconstruction', 'airbnb', 'commercial']
        && request.resource.data.propertyType in ['apartment', '1-2bed', '3-4bed', '5+bed', 'commercial']

        // D. Constraints — admin can pre-assign cleaners; createdBy must match their auth email
        && request.resource.data.preferredDate is string && request.resource.data.preferredDate.size() == 10
        && (request.resource.data.assignedTo == null || request.resource.data.assignedTo is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email

        // E. Optional fields (same as public branch)
        && (!('marketingConsent' in request.resource.data)
            || (request.resource.data.marketingConsent is bool
                && request.resource.data.consentTimestamp is timestamp
                && request.resource.data.consentMethod == 'booking-form-v2'))
        && (!('addOns' in request.resource.data) || request.resource.data.addOns is list)
        && (!('squareFootage' in request.resource.data) || request.resource.data.squareFootage is int)
        && (!('notes' in request.resource.data) || request.resource.data.notes is string)
        // P3-E38 (ADR-020): internal estimate in integer cents
        && (!('estimatedPriceCents' in request.resource.data) || request.resource.data.estimatedPriceCents is int)
        && lastChangeOk();

      // Admin and owner read
      allow read: if isOffice() || (request.auth != null && request.auth.token.email == resource.data.email);

      // Admin update, or customer cancellation (only status field can change to 'cancelled')
      allow update: if lastChangeOk() && (isOffice() || (
        request.auth != null 
        && request.auth.token.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastChange'])
        && request.resource.data.status == 'cancelled'
      ));
      
      // Permanently deleting bookings is forbidden
      allow delete: if false;
    }

    // 2. Admins Collection
    match /admins/{email} {
      // Admins can read their own whitelist document to verify authentication
      // P3-E35: the office can list who has office access (Team & roles); everyone else only their own entry.
      allow read: if isOffice() || (request.auth != null && request.auth.token.email == email);
      // No client code can modify the allowlist
      allow write: if false;
    }

    // 3. Reviews Collection
    match /reviews/{reviewId} {
      // Anyone can read approved reviews, and admins can read all
      allow read: if resource.data.approved == true || isOffice();
      
      // Allow public creation with validation
      allow create: if
        request.resource.data.keys().hasAll(['name', 'location', 'language', 'rating', 'text', 'approved', 'rejected', 'jobId', 'createdAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.approved == false
        && request.resource.data.rejected == false
        && request.resource.data.createdAt == request.time
        && lastChangeOk();
        
      // Moderation changes allowed only for admins
      allow update: if isOffice() && lastChangeOk();
      
      // Prevent direct deletions
      allow delete: if false;
    }

    // 4. Referrals Collection
    match /referrals/{referralCode} {
      // Unauthenticated reads permitted to validate promo code existence in client form
      allow read: if true;
      // Writes reserved for authenticated administrators
      allow write: if isOffice();
    }

    // ── FSM Collections ──────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read:   if (request.auth != null && request.auth.uid == staffId) || isOffice();
      // P3-E27-A2: create removed — all staff docs created server-side by onStaffRegistered CF
      // (Admin SDK bypasses rules). Client-side addDoc to staff is now blocked as defence in depth.
      allow update: if lastChangeOk() && (isOffice()
        || (request.auth != null
            && request.auth.uid == staffId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['constraints', 'preferences', 'financials', 'compliance', 'lastChange'])
            && (!request.resource.data.financials.diff(resource.data.financials).affectedKeys().hasAny(['currentMonthEarningsCents', 'earningsHistory']))
           ));
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read:   if (request.auth != null && resource.data.assignedTo == request.auth.uid) || isOffice();
      allow create: if isOffice() && lastChangeOk();
      allow update: if lastChangeOk() && (isOffice()
        || (request.auth != null
            && resource.data.assignedTo == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'checkedInAt', 'checkedInGeo', 'completedAt', 'checklistCompletions', 'photos', 'lastChange'])
           ));
      allow delete: if false;
    }

    match /payRates/{rateId} {
      allow read:   if isOffice();
      allow create: if isOffice() && lastChangeOk();
      allow update, delete: if false;
    }

    match /auditLog/{logId} {
      // P3-E37: written only by server code (audit triggers, role and policy callables).
      allow read:   if isOffice();
      allow create, update, delete: if false;
    }

    match /checklistTemplates/{templateId} {
      allow read:  if isStaff();
      allow create, update: if isOffice() && lastChangeOk();
      allow delete: if isOffice();
    }

    // P3-E32: before/after gallery pairs (human-approved 2026-10-04)
    match /galleryPairs/{pairId} {
      // Anyone can read published pairs; admins can read all
      allow read: if resource.data.published == true || isOffice();
      allow create, update: if isOffice() && lastChangeOk();
      allow delete: if isOffice();
    }

    match /notifications/{staffId}/messages/{messageId} {
      allow read:   if request.auth != null && request.auth.uid == staffId;
      allow create: if false;
      // N-2 (PENDING HUMAN APPROVAL): the recipient may mark their own message read — only the
      // `read` field, and only to true. Everything else about a message stays server-written.
      allow update: if request.auth != null
                    && request.auth.uid == staffId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // 6. Customers Collection
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 7. Operational Settings & Policy (P3-E36 / W0-2, human-approved 2026-10-27)
    // All staff (owner, manager, supervisor, staff) can read live operational settings;
    // only office (owner, manager) can read the append-only version history;
    // all writes go through the Owner-only updatePolicySettings Cloud Function.
    match /settings/policy {
      allow read: if isStaff();
      allow write: if false;

      match /history/{versionId} {
        allow read: if isOffice();
        allow write: if false;
      }
    }

    // Default Deny-All for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

