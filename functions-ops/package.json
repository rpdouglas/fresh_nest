{
  "name": "schedule-functions",
  "version": "1.0.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/dev.ts",
    "test": "tsx --test src/*.test.ts",
    "test:stores": "firebase emulators:exec --config src/emulator/firebase.json --only firestore --project demo-fnc-stores \"tsx --test src/emulator/*.test.ts\""
  },
  "type": "module",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": "22"
  }
}
