rules_version = '2';

// Gallery block approved by human and deployed 2026-10-04 (P3-E32).
// Everything else is the rule that was live before it (released 2026-05-23): all access denied.
service firebase.storage {
  match /b/{bucket}/o {

    // P3-E35: office = owner or manager (the legacy 'admin' claim is no longer accepted).
    // P3-E32: before/after gallery photos, uploaded from the admin Gallery tab.
    // Admins only. Visitors load photos through the download URLs saved on each
    // galleryPairs document, which do not go through these rules.
    match /gallery/{pairId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.role in ['owner', 'manager'];
      allow write: if request.auth != null
                   && request.auth.token.role in ['owner', 'manager']
                   && (request.resource == null
                       || (request.resource.size < 1 * 1024 * 1024
                           && request.resource.contentType == 'image/jpeg'));
    }

    // FSM crew job photos (checklist photo proof — P11 Brenda). HOTFIX-06, deployed 2026-10-27.
    // Each staff member writes only into their own folder (staffId = their auth uid); files are
    // create-only, so photo evidence can't be overwritten or deleted from a phone. Which job a
    // photo belongs to is enforced in Firestore: only the assigned cleaner can attach it to the
    // job document (firestore.rules jobs update). Admins read everything; staff read their own.
    match /jobs/{jobId}/photos/{staffId}/{photoId} {
      allow read: if request.auth != null
                  && (request.auth.token.role in ['owner', 'manager'] || request.auth.uid == staffId);
      allow create: if request.auth != null
                    && resource == null
                    && request.auth.uid == staffId
                    && request.auth.token.role in ['staff', 'supervisor', 'owner', 'manager']
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
