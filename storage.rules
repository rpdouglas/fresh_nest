rules_version = '2';

// NOT YET DEPLOYED — the gallery block below awaits human approval (P3-E32).
// Everything except the gallery block matches the rules live in the Firebase console
// as of 2026-10-04 (released 2026-05-23): all access denied.
service firebase.storage {
  match /b/{bucket}/o {

    // P3-E32: before/after gallery photos, uploaded from the admin Gallery tab.
    // Admins only. Visitors load photos through the download URLs saved on each
    // galleryPairs document, which do not go through these rules.
    match /gallery/{pairId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && (request.resource == null
                       || (request.resource.size < 1 * 1024 * 1024
                           && request.resource.contentType == 'image/jpeg'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
